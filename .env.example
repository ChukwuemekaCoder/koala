# Supabase Project Settings > Database > Connection string.
# Use the "Connection pooling" (Supavisor) URI, not the direct connection —
# the direct connection is IPv6-only and commonly fails from IPv4-only networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

REDIS_URL=redis://redis:6379/0

# Supabase Project Settings > API. Not required for the skeleton to boot;
# used later for auth/JWT verification work.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Origin allowed to call the backend (CORS). Defaults to the local Vite
# dev server; set to the deployed frontend's origin in prod.
FRONTEND_ORIGIN=http://localhost:5173
